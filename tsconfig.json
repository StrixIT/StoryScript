{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ES2022",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],

        "paths": {
            "storyScript": ["./src/Engine/index.ts"],
            "ui/*": ["./src/UI/*"],
            "src/*": ["./src/*"]
        },
        "typeRoots": ["./node_modules/@types"],
        "types": ["node", "vite/client"],

        "sourceMap": true,
        "noEmitOnError": true,
        "removeComments": false,
        "useDefineForClassFields": true,
        "skipLibCheck": true,

        /* Linting */
        "strict": true,
        "noImplicitAny": false,
        "strictNullChecks": false,

        /* Bundler mode */
        "moduleResolution": "bundler",
        "allowSyntheticDefaultImports": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "noEmit": true,
        "allowJs": true,
    },
    "include": ["src/Engine/**/*", "src/UI/**/*", "typeExtensions.d.ts", "src/constants.ts", "src/index.ts", "vite-env.d.ts", "shims-vue.d.ts"],
    "exclude": ["node_modules", "dist"]
}