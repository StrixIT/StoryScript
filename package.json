{
    "name": "storyscript",
    "description": "StoryScript Adventure",
    "version": "1.0.0",
    "author": "Rutger Schurgers",
    "private": true,
    "type": "module",
    "main": "./src/UI/electron.cjs",
    "build": {
        "appId": "storyscript.id",
        "files": [
            "./src/UI/electron.cjs",
            "dist/**/*"
        ],
        "win": {
            "target": "portable",
            "icon": "dist/icon.ico"
        }
    },
    "scripts": {
        "create-game": "node createGame.js",
        "sca": "node createAsset.js action",
        "scl": "node createAsset.js location",
        "scf": "node createAsset.js feature",
        "sce": "node createAsset.js enemy",
        "scp": "node createAsset.js person",
        "sci": "node createAsset.js item",
        "sck": "node createAsset.js key",
        "scq": "node createAsset.js quest",
        "scm": "node createAsset.js map",
        "start": "vite",
        "test": "node ./src/Tests/Engine/beforeTests.js && vitest --ui",
        "publish": "vite build && node postbuild.js",
        "electron-start": "vite build && electron .",
        "electron-publish": "vite build && node postbuild.js && electron-builder"
    },
    "devDependencies": {
        "@types/node": "^26.6.4",
        "@vitejs/plugin-vue": "^6.0.9",
        "@vitest/coverage-v8": "^5.0.3",
        "@vitest/ui": "^5.0.3",
        "@vue/language-server": "^3.3.12",
        "@vueuse/components": "^15.0.0",
        "@vueuse/core": "^15.0.0",
        "archiver": "^8.0.0",
        "bootstrap": "^5.3.8",
        "electron": "^44.5.1",
        "electron-builder": "^26.15.3",
        "ffmpeg-static": "^5.3.0",
        "fs-extra": "^11.4.1",
        "jsdom": "^30.1.1",
        "jsonfile": "^6.2.1",
        "pinia": "^4.0.3",
        "rollup-plugin-visualizer": "^7.1.1",
        "sass-embedded": "^1.105.1",
        "sharp": "^0.35.5",
        "typescript": "^6.0.3",
        "vite": "^8.3.2",
        "vite-plugin-checker": "^0.14.5",
        "vite-plugin-static-copy": "^4.1.1",
        "vitest": "^5.0.3",
        "vue-tsc": "^3.3.12"
    },
    "allowScripts": {
        "@parcel/watcher@2.6.0": true,
        "electron-winstaller@5.4.0": true,
        "ffmpeg-static@5.3.0": true
    }
}
