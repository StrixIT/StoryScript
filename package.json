{
  "name": "@strixit/storyscript",
  "publishConfig": {
    "access": "public"
  },
  "description": "StoryScript is an engine to create games for the web. Games that run anywhere, online or offline, on any device, and work well with both mouse and touch control. You play your games while you build them! Your changes are shown immediately, allowing you to shape your world as you move through it.",
  "version": "1.0.1",
  "author": "Rutger Schurgers",
  "homepage": "https://www.storyscript.nl",
  "license": "MIT",
  "private": false,
  "type": "module",
  "main": "./electron.cjs",
  "module": "./dist/storyscript.mjs",
  "build": {
    "appId": "storyscript.id",
    "files": [
      "./electron.cjs",
      "dist/**/*"
    ],
    "win": {
      "target": "portable",
      "icon": "dist/icon.ico"
    }
  },
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/storyscript.mjs",
      "types": "./dist/src/index.d.ts"
    },
    "./styles": "./dist/storyscript.css",
    "./vite-config": "./dist/baseViteConfig.js"
  },
  "bin": {
    "storyscript": "./scripts/cli.js"
  },
  "files": [
    "CodeSnippets/StoryScriptSnippets.code-snippets",
    "LiveTemplates",
    "clientFiles",
    "scripts/cli.js",
    "scripts/createGame.js",
    "scripts/createAsset.js",
    "scripts/setupTesting.js",
    "scripts/postbuild.js",
    "scripts/helpers.js",
    "src/Engine",
    "src/UI",
    "src/Games/_GameTemplate",
    "src/Tests/Games/_GameTemplate",
    "dist/**/*.d.ts",
    "!dist/**/Games",
    "!dist/**/Tests",
    "dist/storyscript.*",
    "baseViteConfig.js",
    "typeExtensions.d.ts",
    "shims-vue.d.ts",
    "vite-env.d.ts",
    "index.html",
    "electron.cjs",
    ".env"
  ],
  "scripts": {
    "create-game": "node scripts/createGame.js",
    "sca": "node scripts/createAsset.js action",
    "scl": "node scripts/createAsset.js location",
    "scf": "node scripts/createAsset.js feature",
    "sce": "node scripts/createAsset.js enemy",
    "scp": "node scripts/createAsset.js person",
    "sci": "node scripts/createAsset.js item",
    "sck": "node scripts/createAsset.js key",
    "scq": "node scripts/createAsset.js quest",
    "scm": "node scripts/createAsset.js map",
    "start": "vite",
    "test": "node ./src/Tests/beforeTests.js && node scripts/setupTesting.js && vitest --ui",
    "build": "tsc && vite build",
    "build:package": "tsc && VITE_BUILD_LIB=true vite build",
    "electron-start": "vite build && electron .",
    "electron-build": "vite build && electron-builder",
    "pack:test": "node scripts/pack-and-test.js",
    "pack": "npm run build:package && npm pack"
  },
  "dependencies": {
    "@types/node": "^26.6.4",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/language-server": "^3.3.12",
    "@vueuse/components": "^15.0.0",
    "@vueuse/core": "^15.0.0",
    "archiver": "^8.0.0",
    "fs-extra": "^11.4.1",
    "jsonfile": "^6.2.1",
    "pinia": "^4.0.3",
    "sass-embedded": "^1.105.1",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vite-plugin-checker": "^0.14.5",
    "vite-plugin-pwa": "^2.0.0",
    "vite-plugin-static-copy": "^4.1.1",
    "vue": "^3.5.43",
    "vue-tsc": "^3.3.12",
    "which": "^7.0.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.3",
    "@vitest/ui": "^5.0.3",
    "bootstrap": "^5.3.8",
    "jsdom": "^30.1.1",
    "vitest": "^5.0.3",
    "vite-plugin-dts": "^5.1.2",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "rollup-plugin-visualizer": "^7.1.1"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "electron-winstaller@5.4.0": true
  }
}
